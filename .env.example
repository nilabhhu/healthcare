# =============================================================================
# HealYaar — Environment Variables Template
# =============================================================================
# Copy this file to .env.local or .env and provide your actual Supabase credentials.
# Note: VITE_ variables are bundled with client-side code. Never put secret service-role
# keys or private AI API keys in VITE_ variables.
# =============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
